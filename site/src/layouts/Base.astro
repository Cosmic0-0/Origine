---
import '@/styles/base.css';
import { Font } from 'astro:assets';
import { getDictionary, l, type Locale, defaultLocale } from '@/i18n';
import { getSettings } from '@/lib/content';
import { abs, imageUrl } from '@/lib/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  locale?: Locale;
  jsonLd?: unknown[];
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, image, locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale, jsonLd = [], noindex = false, bodyClass } = Astro.props;
const settings = await getSettings();
const t = getDictionary(locale);
const siteName = settings.siteName ?? t.siteName;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const desc = description ?? l(settings.defaultSeo?.description, locale) ?? l(settings.tagline, locale) ?? '';
const ogImage = image ?? (await imageUrl(settings.defaultSeo?.image));
const canonical = abs(Astro.url.pathname);
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f3ef" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {cfToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfToken}"}`}></script>}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{t.skipToContent}</a>
    <Header locale={locale} settings={settings} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} settings={settings} />
  </body>
</html>
