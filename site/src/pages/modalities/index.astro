---
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';
import { getDictionary, l, localePath, fill, defaultLocale, type Locale } from '@/i18n';
import { getPage, getModalities } from '@/lib/content';
import { formatDuration } from '@/i18n/format';

const locale: Locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = getDictionary(locale);
const [page, modalities] = await Promise.all([getPage('modalities'), getModalities()]);
---
<Base title={l(page.title, locale) ?? t.nav.modalities} description={l(page.seo?.description, locale) ?? l(page.intro, locale)} locale={locale}>
  <section class="wrap page-head">
    <h1>{l(page.title, locale)}</h1>
    {l(page.intro, locale) && <p class="lede">{l(page.intro, locale)}</p>}
    <Prose blocks={l(page.body, locale)} />
  </section>
  <div class="light">
  <section class="wrap section-tight">
    <ul class="modalities">
      {modalities.map((m) => {
        const where = m.where?.includes('inPerson') && m.where?.includes('online') ? t.offer.inPersonAndOnline : m.where?.includes('online') ? t.offer.online : t.offer.inPerson;
        const dur = formatDuration(m.durationMinutes?.min, m.durationMinutes?.max, locale);
        return (
          <li>
            <h2><a href={localePath(`/modalities/${m.slug.current}`, locale)}>{l(m.title, locale)}</a></h2>
            <p class="muted small">{[where, dur].filter(Boolean).join(', ')}</p>
            <p>{l(m.summary, locale)}</p>
            <a class="quiet" href={localePath(`/modalities/${m.slug.current}`, locale)}>{fill(t.cta.aboutName, { name: l(m.title, locale) ?? '' })}</a>
          </li>
        );
      })}
    </ul>
  </section>
  <section class="wrap section-tight">
    <div class="actions" style="margin-top:0"><a class="btn" href={localePath('/work-with-me', locale)}>{t.nav.work}</a></div>
  </section>
  </div>
</Base>
<style>
  .modalities { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .modalities li { padding: 2rem 0; border-top: 1px solid var(--line); display: grid; gap: 0.5rem; max-width: var(--measure); }
  .modalities h2 { font-size: var(--text-xl); }
  .modalities h2 a { text-decoration: none; }
  .modalities h2 a:hover { text-decoration: underline; text-decoration-color: var(--terracotta); }
  .modalities .quiet { justify-self: start; margin-top: 0.5rem; }
</style>
