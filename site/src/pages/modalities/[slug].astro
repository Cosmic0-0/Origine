---
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';
import Photo from '@/components/Photo.astro';
import { getDictionary, l, localePath, fill, defaultLocale, type Locale } from '@/i18n';
import { formatDuration, formatPrice } from '@/i18n/format';
import { getModalities, getSettings, getServices, deref, resolvePhoto } from '@/lib/content';
import { portableTextToPlain } from '@/lib/portableText';
import type { Post } from '@/lib/types';

export async function getStaticPaths() {
  const modalities = await getModalities();
  return modalities.map((m) => ({ params: { slug: m.slug.current }, props: { modality: m } }));
}
const { modality } = Astro.props;
const locale: Locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = getDictionary(locale);
const [settings, services] = await Promise.all([getSettings(), getServices()]);
const single = services.find((s) => s.kind === 'session');
const price = formatPrice(single?.price?.amount, single?.price?.currency, locale);
const post = await deref<Post>(modality.relatedPost);
const photo = await resolvePhoto(modality.image);
const where = modality.where?.includes('inPerson') && modality.where?.includes('online') ? t.offer.inPersonAndOnline : modality.where?.includes('online') ? t.offer.online : t.offer.inPerson;
const dur = formatDuration(modality.durationMinutes?.min, modality.durationMinutes?.max, locale);
const title = l(modality.title, locale) ?? '';
const description = l(modality.seo?.description, locale) ?? l(modality.summary, locale) ?? portableTextToPlain(l(modality.body, locale));
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Service', name: title, description, serviceType: title, provider: { '@id': `${Astro.site}#business` }, areaServed: ['Mauritius', 'Online'] }];
---
<Base title={`${title} in Mauritius`} description={description} locale={locale} jsonLd={jsonLd}>
  <article class="wrap section-tight modality">
    <p class="eyebrow"><a href={localePath('/modalities', locale)} style="text-decoration:none">{t.nav.modalities}</a></p>
    <h1>{title}</h1>
    <p class="muted" style="margin-top:0.75rem">{[where, dur].filter(Boolean).join(', ')}</p>
    {l(modality.summary, locale) && <p class="lede" style="margin-top:1.25rem">{l(modality.summary, locale)}</p>}
    <Photo photo={photo} sizes="(min-width: 52rem) 42rem, 100vw" class="modality-photo" aspect="3/2" />
    <Prose blocks={l(modality.body, locale)} class="modality-body" />
    <div class="actions">
      <a class="btn" href={settings.calendlyUrl ?? localePath('/contact', locale)}>{price ? fill(t.cta.bookWithPrice, { price }) : t.cta.book}</a>
      {post && <a class="quiet" href={localePath(`/blog/${post.slug.current}`, locale)}>{l(post.title, locale)}</a>}
    </div>
  </article>
</Base>
<style>
  .modality { max-width: calc(var(--measure) + 2 * var(--gutter)); }
  .modality :global(.modality-photo) { margin-top: 2rem; }
  .modality :global(.modality-body) { margin-top: 2rem; }
</style>
