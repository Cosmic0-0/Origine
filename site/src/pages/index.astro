---
import Base from '@/layouts/Base.astro';
import Photo from '@/components/Photo.astro';
import Prose from '@/components/Prose.astro';
import Offer from '@/components/Offer.astro';
import Testimonial from '@/components/Testimonial.astro';
import { getDictionary, l, localePath, fill, defaultLocale, type Locale } from '@/i18n';
import { formatPrice, formatEventDate, formatDuration } from '@/i18n/format';
import { getHomePage, getAboutPage, getSettings, getServices, getModalities, getTestimonials, getEvents, resolvePhoto } from '@/lib/content';
import { localBusiness, serviceSchema } from '@/lib/seo';

const locale: Locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = getDictionary(locale);
const [home, about, settings, services, modalities, testimonials, events] = await Promise.all([
  getHomePage(), getAboutPage(), getSettings(), getServices(), getModalities(), getTestimonials(), getEvents({ upcoming: true }),
]);
const featured = services.filter((s) => s.showOnHome);
const single = services.find((s) => s.kind === 'session');
const singlePrice = formatPrice(single?.price?.amount, single?.price?.currency, locale);
const quote = testimonials.find((q) => q.featured);
const moonlight = services.find((s) => s.slug.current === 'moonlight-meditation');
const nextMoon = events.find((e) => e.offer?._ref === moonlight?._id);
const moonPrice = formatPrice(nextMoon?.price?.amount ?? moonlight?.price?.amount, nextMoon?.price?.currency ?? moonlight?.price?.currency, locale);
const moonDuration = formatDuration(moonlight?.durationMinutes?.min, moonlight?.durationMinutes?.max, locale);
const bookHref = settings.calendlyUrl ?? localePath('/contact', locale);
const bookLabel = singlePrice ? fill(t.cta.bookWithPrice, { price: singlePrice }) : t.cta.book;
const [hero, quotePhoto, closingPhoto] = await Promise.all([resolvePhoto(home.heroImage), resolvePhoto(home.quoteImage), resolvePhoto(home.closingImage)]);
const jsonLd = [await localBusiness(settings, locale, services), ...featured.map((s) => serviceSchema(s, locale))];
---
<Base title={t.meta.homeTitle} description={l(home.heroLede, locale)} locale={locale} jsonLd={jsonLd} bodyClass="page-home">
  <section class="hero">
    <div class="hero-text rise">
      <h1>{l(home.heroHeading, locale)}</h1>
      <p class="lede">{l(home.heroLede, locale)}</p>
      <div class="actions">
        <a class="btn" href={bookHref}>{bookLabel}</a>
        <a class="quiet" href="#offers">{t.cta.programme}</a>
      </div>
      {l(home.credentialsLine, locale) && <p class="credentials"><strong>{settings.practitionerName}</strong>{l(home.credentialsLine, locale)}</p>}
    </div>
    <Photo photo={hero} class="hero-photo rise rise-late" priority sizes="(min-width: 52rem) 42vw, 100vw" />
  </section>

  <section class="statement wrap">
    <p class="statement-text">{l(home.statement, locale)}</p>
    {l(home.originMeaning, locale) && <p class="measure muted">{l(home.originMeaning, locale)}</p>}
  </section>

  <section class="light offers section" id="offers">
    <div class="wrap">
      <h2 class="sr-only">{t.home.offersHeading}</h2>
      <div class="offers-grid">
        {featured.map((s) => <Offer service={s} settings={settings} locale={locale} />)}
      </div>
      <div class="ingredients">
        <p class="eyebrow">{t.home.ingredientsHeading}. {t.home.ingredientsNote}</p>
        <ul class="ingredient-list">{modalities.map((m) => <li><a href={localePath(`/modalities/${m.slug.current}`, locale)}>{l(m.title, locale)}</a></li>)}</ul>
        <p style="margin-top:1.25rem"><a class="quiet" href={localePath('/work-with-me', locale)}>{t.cta.howItWorks}</a></p>
      </div>
    </div>
  </section>

  <section class="wrap section who">
    <div>
      <h2>{l(home.whoHeading, locale)}</h2>
      <Prose blocks={l(home.whoBody, locale)} class="who-body" />
    </div>
    {about.training && about.training.length > 0 && (
      <div class="path">
        <h3 class="eyebrow">{l(home.trainingHeading, locale) ?? t.home.trainingHeading}</h3>
        <ol>{about.training.map((i) => <li class={i.highlight ? 'highlight' : ''}>{l(i.label, locale)}{l(i.detail, locale) && <span class="muted">, {l(i.detail, locale)}</span>}</li>)}</ol>
        <p style="margin-top:1.5rem"><a class="quiet" href={localePath('/about', locale)}>{t.cta.moreAbout}</a></p>
      </div>
    )}
  </section>

  {quote && (
    <section class="wrap voice">
      <Photo photo={quotePhoto} sizes="(min-width: 52rem) 30vw, 100vw" aspect="2/3" />
      <Testimonial item={quote} locale={locale} size="large" />
    </section>
  )}

  <section class="band-night moon">
    <div class="wrap">
      <div class="orb" aria-hidden="true"></div>
      <h2>{l(home.moonHeading, locale)}</h2>
      {nextMoon ? (
        <>
          <p class="when"><time datetime={nextMoon.start}>{formatEventDate(nextMoon.start, nextMoon.end, locale)}</time></p>
          <p class="where muted">{[l(nextMoon.location, locale), moonPrice, moonDuration].filter(Boolean).join('. ')}</p>
        </>
      ) : (
        <p class="where muted">{t.events.noneHome}</p>
      )}
      <p class="desc">{l(home.moonBody, locale)}</p>
      <div class="actions">
        <a class="btn" href={localePath('/groups-and-retreats', locale)}>{nextMoon ? t.cta.reserve : t.nav.groups}</a>
        {settings.youtubeUrl && <a class="quiet" href={settings.youtubeUrl} rel="noopener">{t.cta.freeMeditations}</a>}
      </div>
    </div>
  </section>

  <section class="wrap section closing">
    <div class="closing-text">
      <h2>{l(home.closingHeading, locale)}</h2>
      <p class="measure">{l(home.closingBody, locale)}</p>
      <div class="actions">
        <a class="btn" href={bookHref}>{bookLabel}</a>
        {settings.whatsapp && <a class="quiet" href={`https://wa.me/${settings.whatsapp.replace(/\D/g, '')}`} rel="noopener">{t.cta.whatsapp}</a>}
        <a class="quiet" href={localePath('/contact', locale)}>{t.cta.message}</a>
      </div>
      {l(settings.replyPromise, locale) && <p class="form-note" style="margin-top:1rem">{l(settings.replyPromise, locale)}</p>}
    </div>
    <Photo photo={closingPhoto} class="closing-photo" sizes="(min-width: 52rem) 36vw, 100vw" aspect="3/4" />
  </section>
</Base>
<style>
  /* Hero: text left, photo flush to the right edge of the wrap, full height on desktop. */
  .hero { display: grid; gap: 0; max-width: var(--wrap); margin-inline: auto; }
  .hero-text { padding: 1.5rem var(--gutter) 3rem; }
  .hero h1 { max-width: 8ch; }
  .hero .lede { margin-top: 1.75rem; }
  .credentials { margin-top: 2.5rem; font-size: var(--text-sm); color: var(--text-soft); max-width: 42ch; line-height: 1.6; }
  .credentials strong { display: block; }
  .hero-photo { aspect-ratio: 4 / 5; }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 7fr 5fr; min-height: calc(100vh - 5.5rem); }
    .hero-text { padding-top: 3rem; padding-bottom: 3rem; display: flex; flex-direction: column; justify-content: center; }
    .hero-text .credentials { margin-top: auto; padding-top: 3rem; }
    .hero-photo { aspect-ratio: auto; height: 100%; }
  }
  .statement { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(3rem, 7vw, 5rem); border-top: 1px solid var(--line); }
  .statement-text { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.2; color: var(--heading); max-width: 24ch; font-variation-settings: 'opsz' 96; margin-bottom: 1.5rem; }
  .offers-grid { display: grid; gap: 3rem; }
  @media (min-width: 52rem) {
    .offers-grid { grid-template-columns: 1fr 1fr; gap: 0; }
    .offers-grid > :global(.offer) { padding-right: 3.5rem; }
    .offers-grid > :global(.offer + .offer) { border-left: 1px solid var(--line); padding-left: 3.5rem; padding-right: 0; }
  }
  .ingredients { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .ingredient-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 0.5rem; font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.5; font-variation-settings: 'opsz' 48; color: var(--heading); }
  .ingredient-list li:not(:last-child)::after { content: ','; }
  .ingredient-list a { text-decoration: none; }
  .ingredient-list a:hover { text-decoration: underline; text-decoration-color: var(--terracotta); }
  .who { display: grid; gap: 3rem; border-top: 1px solid var(--line); }
  .who h2 { max-width: 14ch; }
  .who :global(.who-body) { margin-top: 1.25rem; max-width: 44ch; }
  @media (min-width: 52rem) { .who { grid-template-columns: 6fr 5fr; gap: 5rem; } }
  .path ol { list-style: none; margin: 1rem 0 0; padding: 0 0 0 1.25rem; border-left: 1px solid var(--line); }
  .path li { position: relative; padding: 0.5rem 0; font-size: 1rem; }
  .path li::before { content: ''; position: absolute; left: calc(-1.25rem - 3px); top: 1.15rem; width: 5px; height: 5px; border-radius: 50%; background: var(--sand); }
  .path li.highlight { color: var(--heading); font-weight: 600; }
  .path li.highlight::before { background: var(--terracotta); }
  .voice { display: grid; gap: 2rem; padding-bottom: clamp(3rem, 8vw, 6rem); align-items: end; }
  @media (min-width: 52rem) { .voice { grid-template-columns: 4fr 7fr; gap: 5rem; } }
  .moon { padding-block: clamp(3.5rem, 8vw, 5.5rem); text-align: center; }
  .moon .orb { width: clamp(5rem, 12vw, 8rem); height: clamp(5rem, 12vw, 8rem); border-radius: 50%; background: var(--terracotta); margin: 0 auto 2rem; }
  .moon h2 { max-width: 14ch; margin-inline: auto; }
  .moon .when { font-family: var(--font-display); font-size: var(--text-lg); color: var(--heading); margin: 1.25rem 0 0.25rem; font-variation-settings: 'opsz' 48; }
  .moon .where { font-size: var(--text-sm); }
  .moon .desc { max-width: 46ch; margin: 1.5rem auto 0; }
  .moon .actions { justify-content: center; margin-top: 2rem; }
  .closing { display: grid; gap: 2.5rem; align-items: center; }
  .closing h2 { max-width: 10ch; }
  .closing p { margin-top: 1.5rem; }
  .closing-photo { aspect-ratio: 3 / 4; }
  @media (min-width: 52rem) { .closing { grid-template-columns: 7fr 5fr; gap: 5rem; } }
</style>
