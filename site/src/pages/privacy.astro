---
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';
import { getDictionary, l, defaultLocale, type Locale } from '@/i18n';
import { getPage } from '@/lib/content';
const locale: Locale = (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const t = getDictionary(locale);
const page = await getPage('privacy');
---
<Base title={l(page.title, locale) ?? t.nav.privacy} description={l(page.intro, locale)} locale={locale}>
  <section class="wrap page-head">
    <h1>{l(page.title, locale)}</h1>
    {l(page.intro, locale) && <p class="lede">{l(page.intro, locale)}</p>}
  </section>
  <div class="light">
    <section class="wrap section-tight"><Prose blocks={l(page.body, locale)} /></section>
  </div>
</Base>
