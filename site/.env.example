# Public site address, used for sitemap, canonical links and sharing images
PUBLIC_SITE_URL=https://www.originehealing.com

# Sanity. Leave the project ID empty to build from the local seed content in src/seed.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Web Analytics token (optional). Leave empty to disable analytics.
PUBLIC_CF_ANALYTICS_TOKEN=
